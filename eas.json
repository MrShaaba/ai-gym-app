{
  "cli": {
    "version": ">= 18.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BILLING_ENV": "test"
      },
      "node": "20.19.4",
      "corepack": true
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BILLING_ENV": "test"
      },
      "node": "20.19.4",
      "corepack": true
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BILLING_ENV": "production"
      },
      "node": "20.19.4",
      "corepack": true
    }
  },
  "submit": {
    "production": {}
  }
}