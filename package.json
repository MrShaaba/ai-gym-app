{
  "name": "ai-gym-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-pre-install": "corepack enable && corepack prepare yarn@4.4.1 --activate",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/web-dev.mjs",
    "web:dev": "node scripts/web-dev.mjs",
    "web:api": "node server/index.mjs",
    "web:build": "expo export --platform web --output-dir web-dist",
    "web:serve": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:server": "node --test server/tests/*.test.mjs",
    "test:member": "node --test web/member/session.test.mjs",
    "test:web": "playwright test",
    "format:web": "prettier --write web server tests/web scripts app/_layout.web.tsx config/supabase.web.ts services/billing/RevenueCatBillingAdapter.web.ts babel.config.js playwright.config.ts",
    "format:web:check": "prettier --check web server tests/web scripts app/_layout.web.tsx config/supabase.web.ts services/billing/RevenueCatBillingAdapter.web.ts babel.config.js playwright.config.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.101.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.15.2",
    "react-native-purchases-ui": "^9.15.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@playwright/test": "^1.64.0",
    "@types/babel__core": "^7",
    "@types/react": "~19.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "yarn@4.4.1+sha512.f825273d0689cc9ead3259c14998037662f1dcd06912637b21a450e8da7cfeb4b1965bbee73d16927baa1201054126bc385c6f43ff4aa705c8631d26e12460f1"
}
